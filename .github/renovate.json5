// Renovate for this repository: the rules of the blueprint in
// .github/renovate-blueprint.json5, then those of the project alone below, which
// override them, such as a package that must wait or two that move together:
// https://docs.renovatebot.com/configuration-options/
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>Dennis-Otto/paperless-sync//.github/renovate-blueprint.json5"],
  packageRules: [
    {
      // The image of Playwright in tests/e2e/run.sh drives only the browsers of the
      // same version of playwright-core in tests/e2e/package.json, so both move in
      // one update; scripts/check-project.sh compares them.
      matchPackageNames: ["mcr.microsoft.com/playwright", "playwright-core"],
      groupName: "Playwright",
    },
    {
      // tests/e2e/compose.paperless.yaml runs the contract tests against two lines of
      // Paperless-ngx: the last release of 2.x, which stays within 2.x, and the current
      // release of 3.x, which moves on to every new release.
      matchPackageNames: ["ghcr.io/paperless-ngx/paperless-ngx"],
      matchCurrentValue: "/^2[.]/",
      allowedVersions: "/^2[.]/",
    },
    {
      // The contract tests are no required check, so GitHub would merge a new image of
      // Paperless-ngx even when they fail. Renovate merges it itself instead, only once
      // every check is green, the contract tests included; its own group keeps a red
      // contract from holding back the other images.
      matchPackageNames: ["ghcr.io/paperless-ngx/paperless-ngx"],
      groupName: "Paperless-ngx",
      platformAutomerge: false,
    },
    {
      // tests/e2e/compose.mysql.yaml tests a MariaDB that every Nextcloud of
      // appinfo/info.xml supports: Nextcloud 33 stops at MariaDB 11.8, 12.3 comes with
      // Nextcloud 35. Raise the bound once the min-version reaches a Nextcloud with 12:
      // https://docs.nextcloud.com/server/latest/admin_manual/installation/system_requirements.html
      matchFileNames: ["tests/e2e/compose.mysql.yaml"],
      matchPackageNames: ["mariadb"],
      allowedVersions: "<12",
    },
  ],
}
